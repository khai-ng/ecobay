{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Serilog": {
    "Properties": {
      "App": "ApiGatewayApi"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "AuthorizationUrl": "http://localhost:5101/realms/ecobay/protocol/openid-connect/auth",
    "TokenUrl": "http://localhost:5101/realms/ecobay/protocol/openid-connect/token"
  },
  "Authentication": {
    "MetadataAddress": "http://localhost:5101/realms/ecobay/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:5101/realms/ecobay",
    "Audience": "account"
  },
  "OpenApi": {
    "Endpoint": {
      "Name": "ApiGateway.API V1"
    },
    "Document": {
      "Description": "The ApiGateway Service HTTP API",
      "Title": "HRM - ApiGateway HTTP API",
      "Version": "v1"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "orders/{**catch-all}"
        }
      },
      "products": {
        "ClusterId": "products",
        "Match": {
          "Path": "products/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders": {
        "ClusterId": "orders",
        "Swagger": {
          "Endpoint": "/orders/swagger/v1/swagger.json",
          "Spec": "/swagger/v1/swagger.json",
          "OriginPath": "",
          "TargetPath": ""
        },
        "Destinations": {
          "default": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "products": {
        "ClusterId": "products",
        "Swagger": {
          "Endpoint": "/products/swagger/v1/swagger.json",
          "Spec": "/swagger/v1/swagger.json",
          "OriginPath": "",
          "TargetPath": ""
        },
        "Destinations": {
          "default": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
